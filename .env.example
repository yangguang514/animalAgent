ANIMAL_AGENT_API_KEY=your_model_api_key_here
ANIMAL_AGENT_BASE_URL=https://api.deepseek.com/v1
ANIMAL_AGENT_MODEL=deepseek-chat
ANIMAL_AGENT_TEMPERATURE=0.4

# LLM reliability and per-turn cost guardrails
LLM_TIMEOUT_MS=45000
LLM_MAX_ATTEMPTS=2
LLM_MAX_OUTPUT_TOKENS=4096
# Planner, Writer, Revision Agent and TitleAgent share this call budget.
LLM_MAX_AGENT_CALLS_PER_TURN=3

# Run at most one automatic revision when the deterministic Critic reports warnings.
CRITIC_REVISION_ENABLED=true

# Knowledge base uploads. Create a Vercel Blob store and copy its read/write token.
BLOB_READ_WRITE_TOKEN=
KNOWLEDGE_MAX_FILE_MB=25
KNOWLEDGE_CHUNK_MAX_CHARS=2200
KNOWLEDGE_CHUNK_OVERLAP_CHARS=280
KNOWLEDGE_RETRIEVAL_LIMIT=8
KNOWLEDGE_MINIMUM_SCORE=0.12
KNOWLEDGE_RETRIEVAL_DISABLED=false

# Embeddings. Without a key, local development falls back to deterministic
# local vectors. Use an OpenAI-compatible embedding endpoint in production.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=48
EMBEDDING_TIMEOUT_MS=45000

# Optional web search. Choose one: tavily, serper, brave, off
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_MS=10000
SEARCH_SNIPPET_MAX_LENGTH=1600
SEARCH_STRICT_ERRORS=false

# LLM search planner. It decides whether to search before each answer.
# Defaults to ANIMAL_AGENT_MODEL when SEARCH_PLANNER_MODEL is empty.
SEARCH_PLANNER_DISABLED=false
SEARCH_PLANNER_MODEL=
SEARCH_PLANNER_TIMEOUT_MS=8000

# Tavily enhanced retrieval
TAVILY_SEARCH_DEPTH=advanced
TAVILY_CHUNKS_PER_SOURCE=3
TAVILY_INCLUDE_ANSWER=false
# false, true, markdown, or text
TAVILY_INCLUDE_RAW_CONTENT=false
TAVILY_AUTO_PARAMETERS=false
TAVILY_TOPIC=general
# TAVILY_USE_TRUSTED_DOMAINS=true
# TAVILY_INCLUDE_DOMAINS=iucnredlist.org,animaldiversity.org,itis.gov,gbif.org,eol.org
# TAVILY_EXCLUDE_DOMAINS=
# TAVILY_TIME_RANGE=
# TAVILY_COUNTRY=

# Local development:
STORAGE_PROVIDER=json

# Vercel deployment:
# STORAGE_PROVIDER=postgres
# Add Vercel Postgres / Neon env vars, for example POSTGRES_URL.

PORT=3010
